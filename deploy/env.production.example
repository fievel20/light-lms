# Light LMS — production settings.
# Copy to /var/www/light-lms/shared/.env on the server, fill in the blanks,
# then run once: php artisan key:generate (from a release directory).
# Never commit the real file.

APP_NAME="Light LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.example.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=light_lms
DB_USERNAME=light_lms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMTP Ionos (create the sender mailbox in the Ionos control panel first).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.ionos.fr
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
